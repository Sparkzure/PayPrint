# ---------------------------------------------------------------
# 运行时数据（数据库、上传文件）
# ---------------------------------------------------------------
data/
*.db
*.db-wal
*.db-shm

# ---------------------------------------------------------------
# 项目内隔离的工具链与缓存（仅本地开发用，不是本仓库的构建前提）
#
# .tools/ 里放着 Go 工具链、node、goose、sqlc 以及全部缓存。
# 这是一套**可选的**本地隔离环境：仓库里的构建脚本在没有它时会退回系统
# Go / Node，因此这里的一切都不进仓库。详见 docs/DEVELOPMENT.md。
# ---------------------------------------------------------------
.tools/

# ---------------------------------------------------------------
# 前端（已拆到 PayPrint-Frontend 仓库；这里只留嵌入产物）
# ---------------------------------------------------------------
*.tsbuildinfo

# 前端产物由 scripts/web.sh / web.ps1 下载后放进这里，再由 go:embed 打进二进制。
# 只保留那个点开头的占位文件（没有它 go:embed 会匹配不到文件而编译不过）。
server/internal/webui/dist/*
!server/internal/webui/dist/.gitkeep

# air 热重载的工作目录（dev 二进制与构建日志）
tmp/

# ---------------------------------------------------------------
# 本地环境
# ---------------------------------------------------------------
# 直接运行二进制时在工作目录下生成的配置文件；真实部署里的那份当然也不进仓库。
payprint.conf
.env
.env.local
.env.*.local

# ---------------------------------------------------------------
# 编辑器 / 系统 / 工具数据
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# AI 辅助工具的项目数据（记忆、会话缓存等），只对本地有意义。
.codebuddy/

# ---------------------------------------------------------------
# 构建产物与临时文件
# ---------------------------------------------------------------
# build 脚本把单二进制出在这里（-Out 可以改）。
# 锚定仓库根：不带斜杠前缀会连 server/internal/webui/dist/ 一起忽略，
# 导致 .gitkeep 白名单失效、CI 检出后 go:embed 编译失败。
/dist/
server/payprint-server
server/payprint-server.exe
*.log

# 覆盖测试报告
coverage.out
web/coverage/
